# ==============================================================================
# Scoped-Deontic RAG (.gitignore)
# ==============================================================================

# --- Operating System Files ---
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db
Desktop.ini
$RECYCLE.BIN/

# --- Python Bytecode & Runtime Cache ---
__pycache__/
*.py[cod]
*$py.class
*.so
.Python

# --- Virtual Environments ---
.venv/
venv/
venv*/
ENV/
env/
env.bak/
venv.bak/

# --- Secrets, API Keys & Environment Variables ---
.env
.env.*
!.env.example
.streamlit/secrets.toml

# --- Vector Database & Persistent Storage ---
# ChromaDB persistence, SQLite indices and binary link lists
chroma_db/
data/vector_store/
*.sqlite3
*.sqlite3-journal
*.bin

# --- Temporary Files & Test Run Dumps ---
test_raw_corpus_ingestion_result.txt
test_scoped_deontic_ingestion_result.txt
*.log
*.tmp
*.temp

# --- Jupyter Notebook Checkpoints ---
.ipynb_checkpoints
*/.ipynb_checkpoints/*
.ipython/

# --- Testing & Coverage ---
.pytest_cache/
.coverage
.coverage.*
htmlcov/
.tox/
.nox/

# --- Playwright & Headless Browser Artifacts ---
.playwright/
test-results/
playwright-report/
playwright/.cache/

# --- IDE & Editor Settings ---
.idea/
*.sublime-project
*.sublime-workspace
# Keep shared workspace configs if desired, ignore local state:
.vscode/*
!.vscode/settings.json
!.vscode/tasks.json
!.vscode/launch.json
!.vscode/extensions.json

# --- LaTeX Build Artifacts (docs/scoped_deontic_rag_ieee.tex) ---
docs/*.aux
docs/*.bbl
docs/*.blg
docs/*.fdb_latexmk
docs/*.fls
docs/*.log
docs/*.out
docs/*.synctex.gz
docs/*.toc
docs/*.pdf
*.aux
*.bbl
*.blg
*.fdb_latexmk
*.fls
*.log
*.out
*.synctex.gz
*.toc